{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Store products catalog",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "oldPrice": { "type": "number" },
        "discountPercent": { "type": "number" },
        "category": { "type": "string" },
        "rating": { "type": "number" },
        "reviewsCount": { "type": "number" },
        "soldCount": { "type": "string" },
        "image": { "type": "string" },
        "inStock": { "type": "boolean" },
        "isFlashDeal": { "type": "boolean" },
        "isTrending": { "type": "boolean" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "price", "category", "image"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer purchase orders",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customerName": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "items": { "type": "array" },
        "totalPrice": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "customerName", "phone", "totalPrice", "status"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Store customers and shoppers",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "city": { "type": "string" },
        "country": { "type": "string" },
        "totalOrders": { "type": "number" },
        "totalSpent": { "type": "number" },
        "status": { "type": "string" },
        "joinedDate": { "type": "string" },
        "avatar": { "type": "string" }
      },
      "required": ["id", "name", "phone"]
    },
    "Setting": {
      "title": "Setting",
      "description": "Store configuration and preferences",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "storeName": { "type": "string" },
        "tagline": { "type": "string" },
        "currencySymbol": { "type": "string" },
        "updatedAt": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "#/entities/Product",
      "description": "Public read products, writeable by admin"
    },
    "/orders/{orderId}": {
      "schema": "#/entities/Order",
      "description": "Orders created by shoppers and managed by admin"
    },
    "/customers/{customerId}": {
      "schema": "#/entities/Customer",
      "description": "Registered shoppers and customers"
    },
    "/settings/{settingId}": {
      "schema": "#/entities/Setting",
      "description": "Application settings"
    }
  }
}
